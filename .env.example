# ORBIT — Explore the Universe Environment Configuration

# Server Port
PORT=5001

# Application Environment (development | production)
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# For local MongoDB Compass: mongodb://127.0.0.1:27017/orbit_db
MONGODB_URI=mongodb://127.0.0.1:27017/orbit_db

# JWT Secret for authenticating sessions and signing tokens
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters

# Client Origin (for CORS policy)
CLIENT_URL=http://localhost:5173
